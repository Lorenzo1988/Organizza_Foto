# .env.example — template pubblico senza valori reali
# Copia questo file in .env e compilalo con i tuoi percorsi.
# Il file .env NON deve mai essere committato su Git.

# Percorsi cartelle (obbligatori)
SOURCE_FOLDER=C:\percorso\alla\cartella\sorgente
DESTINATION_FOLDER=C:\percorso\alla\cartella\destinazione

# Livello di log (opzionale): DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=WARNING

# Credenziali cloud (opzionali, solo se usi ExportAgent)
GOOGLE_PHOTOS_API_KEY=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
DROPBOX_ACCESS_TOKEN=

# GPS stripping (opzionale): True per rimuovere GPS da TUTTE le foto
STRIP_GPS_ALWAYS=False
